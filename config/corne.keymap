/*
 * Copyright (c) 2020 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 *
 * Corne Keymap v24
 * Reference: https://zmk.dev/docs/keymaps/behaviors/key-press
 * Notation (LP/RP/LT/RT, L0–L3, M1–M4/M1b–M4b): corne_prod_v20_notation.md
 *
 * Changes from v23:
 *  - [cc] 2026-11-23: LP2 (left-most column, row 2) on L1, L2, L3 = go_l0 (one tap back to L0; was &none).
 *  - [cc] 2026-11-23: RT3 (right inner thumb) on L1, L2, L3 = go_l0 (was &none).
 *  - [cc] 2026-11-23: every empty left thumb on L1, L2, L3 = go_l0: LT1 on L1/L2/L3 and LT3 on L3
 *    (was &none). On L3 every thumb now returns to L0.
 *  - [cc] 2026-11-23: L1 , . / ; ' = go_l0. , . / were the mirrored right mods (RGUI RALT RCTRL), now removed
 *    from L1; ; and ' were &none. RP3 right Shift on L1 is kept.
 *
 * v23 changes from v22 (kept for history):
 *  - [cc] 2026-11-22: SC (Cmd+Ctrl+Shift+4), SCA (Cmd+Shift+4) and C-b (Ctrl+B) moved from L1 to
 *    L2 on the same A / S / F keys, as one-shot &sym keys (send, then back to L0) like the
 *    other L2 keys; their L1 spots are now &none.
 *  - [cc] 2026-11-22: L2 Ctrl+← / Ctrl+→ (D / F) removed to make room: D = &none, F = C-b.
 *  - [cc] 2026-11-22: mac_sc / mac_sca macros removed (replaced by &sym with modifier functions).
 *  - [cc] 2026-11-23: L2 V = &tmux_nav (C-b, then v: toggles tmux statusline-navigation mode),
 *    then back to L0 like the other L2 keys.
 *
 * v22 changes from v21 (the Sofle v5 changes, ported; kept for history):
 *  - [cc] L2 D / F = Ctrl+← / Ctrl+→ (the Corne had none before).
 *  - [cc] L2 symbols (incl. ' and ") and Ctrl+← / Ctrl+→ are one-shot: &sym taps the key, then
 *    returns to L0 with the L0 colour (white), like go_l0. Mods held at the same time still apply;
 *    a one-shot key does not auto-repeat when held.
 *  - [cc] RT1 on L1 and L3 = go_l0, the same as RT2 (and LT2).
 *  - [cc] L2 LT3 = go_l1 (L1 ⇄ L2 by tapping LT3); L2 RT1 (right-end thumb) = go_l3, the only way to L3.
 *    The Sofle uses its fifth (outermost) right thumb for this; RT1 is the Corne's right-end thumb.
 *
 * v21 changes from v20 (kept for history):
 *  - [cc] L3: added underglow brightness up (G) / down (B) under HUD's row.
 *  - [cc] Per-layer underglow colour: layer-switch keys (LT3, LT2, RT2) are now
 *    macros go_l0..go_l3 that switch layer + set colour.
 *    L0 = white, L1 = green, L2 = blue, L3 = purple. Colour only; on/off
 *    is left to TOG on L3.
 *  - [cc] Layer colours use custom &rgb_hs (hue+sat only), so BRI/BRD
 *    brightness persists across layer switches (was reset every switch).
 *  - [cc] RT2 on L1–L3 = go_l0 (thumb way back to L0).
 *  - [cc] LP2 on L1–L3 = &none.
 *  - [cc] LT2 on L1–L3 = go_l0 (left-thumb way back to L0, mirrors RT2).
 *  - [cc] L0: RP2 = ' (was M2/Alt); RT3 = tap ESC / hold M2 (Alt) via &mt.
 *  - [cc] L2: * is now plain STAR (was KP_MULTIPLY, keypad code);
 *    LP3 = M4 (left Shift) for Shift-shortcuts like Cmd+Shift+[.
 *
 * v20 changes from v19 (kept for history):
 *  - [cc] Four layers only: L0 Default, L1 Lower, L2 Raise, L3 Func.
 *    v19 Num (3) and Template (5) removed; v19 Func moved to L3.
 *  - [cc] Layer switching is persistent (&to), no hold-layers:
 *      LT3 steps L0 → L1 → L2 → L3 (none on L3);
 *      LP2 on L1–L3 jumps back to L0.
 *  - [cc] No transparent keys: every unused key is &none.
 *  - [cc] L0 outer/thumb keys reassigned: LP1 TAB, LP2 Alt+BSPC, LP3 LShift,
 *    RP1 Ctrl, RP2 Alt, RP3 RShift, LT1 Cmd, LT2 BSPC, RT3 ESC, RT2 SPC, RT1 ENT.
 *    All modifiers are plain holds (no sticky keys, no mod-taps).
 *  - [cc] L1–L3: Ctrl/Alt/Cmd on Z X C; L1 also has mirrored right mods on
 *    / . , and Shift on LP3/RP3.
 *  - [cc] L2: ' and " moved to RP2/RP3; ~ on LP1.
 *  - [cc] L3: F1–F12 on the U–/ 4×3 block, RGB on A S D F, BT_CLR on LP1;
 *    media keys removed.
 *  - [cc] Removed unused macros/behaviors (ctrl_alt_*, cmd_*, macos_input,
 *    lm_lwr_lgui, ht_lm_esc, ht_sl_mo) and the Num layer.
 *  - [cc] Each layer has a display-name so the OLED shows L0–L3.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

// ============================================================
// Hardware
// ============================================================

&led_strip {
    chain-length = <27>;
};

// ============================================================
// Layer indices
// ============================================================

#define L0 0
#define L1 1
#define L2 2
#define L3 3


// ============================================================
// Behaviors
// ============================================================

/ {
    behaviors {
        // [cc] v21: custom behavior from this repo's module (zephyr/module.yml).
        // &rgb_hs <hue> <sat>: set underglow colour, keep current brightness.
        // Node name kept short (split transport sends behavior names).
        rgb_hs: rgb_hs {
            compatible = "zmk,behavior-rgb-hue-sat";
            #binding-cells = <2>;
        };
    };
};

// ============================================================
// Macros
// ============================================================

/ {
    macros {


        // [cc] v21: per-layer underglow colour. Stock ZMK has no per-layer
        // RGB, so every layer-switch key is a macro that switches the layer
        // AND sets the colour. They only set the colour, never on/off: on/off
        // is controlled solely by TOG on L3. (HSB: hue 0–360, sat 0–100,
        // brightness 0–100.)
        // [cc] Uses the custom &rgb_hs behavior (src/behaviors/behavior_rgb_hue_sat.c)
        // which sets hue + saturation only, so BRI/BRD brightness persists
        // across layer switches.
        // Effect should be "solid" (EFF) for the colour to show cleanly.

        // L0: white (sat 0)
        go_l0: go_l0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms  = <0>;
            bindings
                = <&macro_tap &rgb_hs 0 0>
                , <&macro_tap &to L0>
                ;
        };

        // [cc] v22: one-shot key for L2 (ported from Sofle v5). &sym X taps X, then goes to L0
        // [cc] and sets the L0 colour, so each L2 symbol drops back to the base layer after one press.
        sym: symbol_then_l0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_tap &rgb_hs 0 0>
                , <&macro_tap &to L0>
                ;
        };

        // [cc] v23: tmux nav key. Sends the tmux prefix C-b, then v, which toggles tmux's
        // [cc] statusline-navigation mode (ysconfig tmux/scripts/slnav.conf), then returns to L0
        // [cc] with the L0 colour, like the other one-shot L2 keys.
        tmux_nav: tmux_nav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(B) &kp V>
                , <&macro_tap &rgb_hs 0 0>
                , <&macro_tap &to L0>
                ;
        };

        // L1: green
        go_l1: go_l1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms  = <0>;
            bindings
                = <&macro_tap &rgb_hs 120 100>
                , <&macro_tap &to L1>
                ;
        };

        // L2: blue
        go_l2: go_l2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms  = <0>;
            bindings
                = <&macro_tap &rgb_hs 240 100>
                , <&macro_tap &to L2>
                ;
        };

        // L3: purple
        go_l3: go_l3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms  = <0>;
            bindings
                = <&macro_tap &rgb_hs 280 100>
                , <&macro_tap &to L3>
                ;
        };
    };
};

// ============================================================
// Keymap
// ============================================================

/ {
    keymap {
        compatible = "zmk,keymap";

        // ----------------------------------------------------
        // L0 — Default (QWERTY)
        //
        // │ TAB    │ Q │ W │ E │ R │ T │   │ Y │ U │ I │ O │ P │ M1  │
        // │ M2+BSPC│ A │ S │ D │ F │ G │   │ H │ J │ K │ L │ ; │ '   │
        // │ M4     │ Z │ X │ C │ V │ B │   │ N │ M │ , │ . │ / │ M4b │
        //        M3 │ BSPC │ →L1     ESC/M2 │ SPC │ ENT
        // ----------------------------------------------------
        default_layer {
            display-name = "L0";
            bindings = <
   &kp TAB       &kp Q  &kp W  &kp E  &kp R     &kp T        &kp Y    &kp U      &kp I      &kp O    &kp P     &kp LCTRL
   &kp LA(BSPC)  &kp A  &kp S  &kp D  &kp F     &kp G        &kp H    &kp J      &kp K      &kp L    &kp SEMI  &kp SQT 
   &kp LSHFT     &kp Z  &kp X  &kp C  &kp V     &kp B        &kp N    &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                               &kp LGUI  &kp BSPC  &go_l1    &mt LALT ESC  &kp SPACE  &kp RET
            >;
        };

        // ----------------------------------------------------
        // L1 — Lower: numbers, arrows, mods
        // [cc] v23: SC / SCA / C-b moved to L2 (same A / S / F keys).
        //
        // │ `   │ 1  │ 2   │ 3  │ 4   │ 5 │   │ 6 │ 7 │ 8   │ 9   │ 0   │ ✕   │
        // │ →L0 │ ✕  │ ✕   │ ✕  │ ✕   │ ✕ │   │ ← │ ↓ │ ↑   │ →   │ →L0 │ →L0 │
        // │ M4  │ M1 │ M2  │ M3 │ ✕   │ ✕ │   │ ✕ │ ✕ │ →L0 │ →L0 │ →L0 │ M4b │
        //      →L0 │ →L0 │ →L2     →L0 │ →L0 │ →L0   ([cc] v22: RT1 →L0; v24: LP2, LT1, RT3, , . / ; ' →L0)
        // ----------------------------------------------------
        lower_layer {
            display-name = "L1";
            bindings = <
   &kp GRAVE  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5     &kp N6    &kp N7    &kp N8    &kp N9     &kp N0     &none
   &go_l0     &none      &none     &none     &none      &none      &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &go_l0     &go_l0
   &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none      &none      &none     &none     &go_l0    &go_l0     &go_l0     &kp RSHFT
                                   &go_l0    &go_l0     &go_l2     &go_l0    &go_l0    &go_l0
            >;
        };

        // ----------------------------------------------------
        // L2 — Raise: symbols
        //
        // │ ~   │ !  │ @  │ #  │ $ │ % │   │ ^ │ & │ * │ ( │ ) │ ✕ │
        // │ →L0 │ SC │ SCA │ ✕  │ C-b │ ✕ │   │ [ │ - │ = │ ] │ \ │ ' │
        // │ M4  │ M1 │ M2 │ M3  │ NAV │ ✕ │   │ { │ _ │ + │ } │ | │ " │
        //      →L0 │ →L0 │ →L1     →L0 │ →L0 │ →L3   ([cc] v24: LP2, LT1, RT3 →L0)
        // [cc] v22: every symbol and C-← / C-→ is one-shot (&sym: type it, then back to L0).
        // [cc] v23: SC / SCA / C-b moved here from L1 (also one-shot); C-← / C-→ removed.
        // [cc] v23: V = NAV (C-b then v: tmux statusline-navigation toggle), one-shot.
        // ----------------------------------------------------
        raise_layer {
            display-name = "L2";
            bindings = <
   &sym TILDE  &sym EXCL  &sym AT   &sym HASH      &sym DLLR       &sym PRCNT    &sym CARET  &sym AMPS   &sym STAR   &sym LPAR  &sym RPAR  &none
   &go_l0      &sym LG(LC(LS(N4)))  &sym LG(LS(N4))  &none  &sym LC(B)  &none   &sym LBKT   &sym MINUS  &sym EQUAL  &sym RBKT  &sym BSLH  &sym SQT
   &kp LSHFT   &kp LCTRL  &kp LALT  &kp LGUI       &tmux_nav       &none         &sym LBRC   &sym UNDER  &sym PLUS   &sym RBRC  &sym PIPE  &sym DQT
                                    &go_l0         &go_l0          &go_l1        &go_l0      &go_l0      &go_l3
            >;
        };

        // ----------------------------------------------------
        // L3 — Func: Bluetooth, RGB underglow, F1–F12
        //
        // │ BT_CLR │ BT0 │ BT1 │ BT2 │ BT3 │ BT4 │   │ ✕ │ F1 │ F2  │ F3  │ F4  │ ✕ │
        // │ →L0    │ TOG │ EFF │ HUI │ HUD │ BRI │   │ ✕ │ F5 │ F6  │ F7  │ F8  │ ✕ │
        // │ ✕      │ M1  │ M2  │ M3  │ ✕   │ BRD │   │ ✕ │ F9 │ F10 │ F11 │ F12 │ ✕ │
        //      →L0 │ →L0 │ →L0     →L0 │ →L0 │ →L0   ([cc] v22: RT1 →L0; v24: LP2, LT1, LT3, RT3 →L0)
        // BRI/BRD = underglow brightness up/down (added in v21).
        // [cc] v24: all six thumbs exit to L0 here (LT3 was &none). [cc] v22: L3 is reached only by RT1 on L2.
        // ----------------------------------------------------
        func_layer {
            display-name = "L3";
            bindings = <
   &bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4    &none  &kp F1  &kp F2   &kp F3   &kp F4   &none
   &go_l0      &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_BRI &none  &kp F5  &kp F6   &kp F7   &kp F8   &none
   &none       &kp LCTRL        &kp LALT         &kp LGUI         &none            &rgb_ug RGB_BRD &none  &kp F9  &kp F10  &kp F11  &kp F12  &none
                                                 &go_l0           &go_l0           &go_l0          &go_l0  &go_l0  &go_l0
            >;
        };
    };
};
